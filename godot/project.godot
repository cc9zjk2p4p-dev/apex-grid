; Apex Grid — Godot 4 project
; Open this folder (godot/) in Godot 4.3 or newer.

config_version=5

[application]
config/name="Apex Grid"
config/description="Own the race. Master the strategy. Become the champion."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/version="0.1.0"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1100
window/size/window_height_override=700
window/stretch/mode="canvas_items"
window/handheld/orientation=1
window/ios/override_gesture=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.075, 1)
